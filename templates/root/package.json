{
  "name": "kronos-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "db:generate": "drizzle-kit generate",
    "ui-contract": "bun src/app/ui-contract.ts",
    "infra:up": "docker compose up -d --wait",
    "telemetry:up": "docker compose --profile telemetry up -d --wait telemetry"
  },
  "dependencies": {
    "@kronos-ts/core": "0.11.0",
    "@kronos-ts/kronosdb": "0.13.2",
    "@kronos-ts/otlp": "0.7.4",
    "@kronos-ts/postgres": "0.21.2",
    "@orpc/contract": "2.0.0-beta.36",
    "@orpc/openapi": "2.0.0-beta.36",
    "@orpc/server": "2.0.0-beta.36",
    "@orpc/zod": "2.0.0-beta.36",
    "drizzle-orm": "0.44.7",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kronos-ts/test": "0.9.0",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "imports": {
    "#kit": "./src/kit/index.ts",
    "#kit/*": "./src/kit/*.ts",
    "#test": "./test/index.ts"
  }
}
